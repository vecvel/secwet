# Settings for deploy/compose.yml. The deploy workflow writes the real .env on
# the server from GitHub Actions secrets and variables; never commit a filled-in
# copy. Running locally: copy to deploy/.env and fill in.

# Public name of the relay. Its DNS A (and AAAA) record must point at the server.
RELAY_DOMAIN=relay.example.com
# Contact for the free Let's Encrypt certificate (expiry notices only).
ACME_EMAIL=ops@example.com

# Images, set by the workflow to the exact build being deployed.
RELAY_IMAGE=ghcr.io/vecvel/secwet-relay:latest
BACKUP_IMAGE=ghcr.io/vecvel/secwet-backup:latest

# Database password. Generate once: openssl rand -base64 33
# Changing it later also needs ALTER USER inside Postgres.
POSTGRES_PASSWORD=change-me

# Relay behaviour.
RETENTION_DAYS=30
DEFAULT_DEVICE_LIMIT=5

# Backups: encrypted with this passphrase (AES-256). Keep a copy somewhere
# safe outside the server; without it the backups cannot be restored.
# Generate once: openssl rand -base64 33
BACKUP_PASSPHRASE=change-me
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=3
# Optional off-server copy through rclone, e.g. b2:my-bucket/secwet. The remote
# is defined in rclone.conf next to compose.yml (the workflow writes it from
# the RCLONE_CONF secret). Empty keeps backups on the server only.
RCLONE_REMOTE=
