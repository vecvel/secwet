{
  "$description": "Single source of truth for Secwet design tokens. Run `pnpm tokens` after editing to regenerate CSS and Flutter outputs.",
  "palette": "Moss",
  "color": {
    "light": {
      "sidebarBg": "#F6F4EF",
      "bg": "#FFFFFF",
      "surface": "#FAF9F6",
      "surfaceSunken": "#F2EFE9",
      "textPrimary": "#26231E",
      "textSecondary": "#5A554B",
      "textTertiary": "#746E62",
      "border": "rgba(38, 35, 30, 0.035)",
      "borderStrong": "rgba(38, 35, 30, 0.065)",
      "borderSeparator": "rgba(38, 35, 30, 0.055)",
      "treeGuide": "rgba(38, 35, 30, 0.16)",
      "cardHeaderBg": "rgba(38, 35, 30, 0.025)",
      "accent": "#3D6A4C",
      "accentContrast": "#FFFFFF",
      "accentTint": "rgba(61, 106, 76, 0.13)",
      "accentTintSoft": "rgba(61, 106, 76, 0.07)",
      "accentFill": "#3D6A4C",
      "onAccentFill": "#FFFFFF",
      "success": "#2D7248",
      "warning": "#8F5F00",
      "danger": "#B0372D",
      "dangerFill": "#B0372D",
      "onDangerFill": "#FFFFFF",
      "scrim": "rgba(26, 25, 22, 0.32)"
    },
    "dark": {
      "sidebarBg": "#1A1916",
      "bg": "#131210",
      "surface": "#1C1B18",
      "surfaceSunken": "#0E0D0C",
      "textPrimary": "#EDEAE3",
      "textSecondary": "#B5B0A5",
      "textTertiary": "#8E897E",
      "border": "rgba(237, 234, 227, 0.035)",
      "borderStrong": "rgba(237, 234, 227, 0.065)",
      "borderSeparator": "rgba(237, 234, 227, 0.055)",
      "treeGuide": "rgba(237, 234, 227, 0.16)",
      "cardHeaderBg": "rgba(237, 234, 227, 0.03)",
      "accent": "#8FBE9C",
      "accentContrast": "#13201A",
      "accentTint": "rgba(143, 190, 156, 0.15)",
      "accentTintSoft": "rgba(143, 190, 156, 0.08)",
      "accentFill": "#3D6A4C",
      "onAccentFill": "#F6F4EF",
      "success": "#7FC28F",
      "warning": "#E0B04D",
      "danger": "#EE8A7F",
      "dangerFill": "#B0372D",
      "onDangerFill": "#FFF5F3",
      "scrim": "rgba(0, 0, 0, 0.5)"
    }
  },
  "font": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
  },
  "fontSize": { "xs": 11, "sm": 12, "md": 13, "base": 14, "lg": 16, "xl": 20, "xxl": 26 },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
  "lineHeight": { "tight": 1.25, "base": 1.5 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "small": 6, "control": 8, "card": 8, "dialog": 12, "pill": 8, "count": 4},
  "control": { "height": 32, "heightLarge": 40, "touchTarget": 44 },
  "layout": { "sidebarWidth": 232, "railWidth": 64, "topBarHeight": 52, "bottomBarHeight": 56 },
  "breakpoint": { "compact": 640, "medium": 1024 },
  "shadow": { "overlay": "0 12px 32px rgba(0, 0, 0, 0.14)" },
  "duration": { "fast": 120, "base": 180 }
}
