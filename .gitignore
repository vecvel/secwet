/target
node_modules/
dist/
apps/desktop/src-tauri/gen/
.DS_Store

# SQLite databases
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Documentation & notes (the shipped docs are listed explicitly; a bare
# `docs/` would hide every file below it from negation)
docs/*
!docs/IMPLEMENTATION.md
!docs/design-decisions.md
!docs/ui-rules.md
!docs/mobile-ffi.md
!docs/app-layer.md
!docs/biometric-unlock.md
!docs/m7-m8-architecture.md
*.log

# Scripts & temporary verification scripts
scripts/
**/scripts/
# The iOS Runner's "Build Rust" phase runs this one.
!apps/mobile/scripts/
scratch/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo

# Flutter
apps/mobile/.dart_tool/
apps/mobile/build/
.agents/
.claude/
